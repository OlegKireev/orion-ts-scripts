{
  "name": "orion-ts-scripts",
  "version": "1.0.0",
  "description": "Orion launcher (Ultima Online) typescript scripts builder",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "copy": "node copy-dist.js",
    "deploy": "npm run build && npm run copy",
    "typecheck": "tsc --noEmit"
